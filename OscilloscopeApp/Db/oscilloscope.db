#EPICS Database for RTM3000 Oscilloscope using provided protocol (All Channels)

record(bo, "Reset") 
{ 
    field(DESC, "Reset the oscilloscope") 
    field(DTYP, "stream") 
    field(OUT, "@oscilloscope.proto reset() OSCILLO") 
    field(ZNAM, "Off") 
    field(ONAM, "Reset") 
}

#Enable Channels 1-4

record(bo, "A1:Enable_CH1") 
{ 
    field(DESC, "Enable Channel 1") 
    field(DTYP, "stream") 
    field(OUT, "@oscilloscope.proto enableChannel1 OSCILLO") 
    field(ZNAM, "Disabled") 
    field(ONAM, "Enabled") 
}

record(bo, "Enable_CH2") 
{ 
    field(DESC, "Enable Channel 2") 
    field(DTYP, "stream") 
    field(OUT, "@oscilloscope.proto enableChannel2 OSCILLO") 
    field(ZNAM, "Disabled") 
    field(ONAM, "Enabled") 
}

record(bo, "Enable_CH3") 
{ 
    field(DESC, "Enable Channel 3") 
    field(DTYP, "stream") 
    field(OUT, "@oscilloscope.proto enableChannel3 OSCILLO") 
    field(ZNAM, "Disabled") 
    field(ONAM, "Enabled") 
}

record(bo, "Enable_CH4") 
{ 
    field(DESC, "Enable Channel 4") 
    field(DTYP, "stream") 
    field(OUT, "@oscilloscope.proto enableChannel4 OSCILLO") 
    field(ZNAM, "Disabled") 
    field(ONAM, "Enabled") 
}

#Setup Commands

record(bo, "SetMaxDataPoints") 
{ 
    field(DESC, "Set max data points for waveform") 
    field(DTYP, "stream") 
    field(OUT, "@oscilloscope.proto setMaxDataPoints() OSCILLO") 
    field(ZNAM, "No") 
    field(ONAM, "Yes") 
}

record(bo, "SetFormatASCII") 
{ 
    field(DESC, "Set waveform format to ASCII") 
    field(DTYP, "stream") 
    field(OUT, "@oscilloscope.proto setFormatASCII() OSCILLO") 
    field(ZNAM, "No") 
    field(ONAM, "Yes") 
}

record(bo, "SetByteOrder") 
{ 
    field(DESC, "Set byte order to LSBF") 
    field(DTYP, "stream") 
    field(OUT, "@oscilloscope.proto setByteOrder() OSCILLO") 
    field(ZNAM, "No") 
    field(ONAM, "Yes") 
}

record(bo, "SingleAcquisition") 
{
     field(DESC, "Trigger single acquisition") 
     field(DTYP, "stream") 
     field(OUT, "@oscilloscope.proto singleAcquisition() OSCILLO") 
     field(ZNAM, "No") 
     field(ONAM, "Yes") 
}

#Read waveform headers (all channels)

record(stringin, "WaveformHeader_CH1") 
{ 
    field(DESC, "Read waveform header CH1") 
    field(DTYP, "stream") 
    field(INP, "@oscilloscope.proto getWaveformHeader() OSCILLO") 
    field(SCAN, "Passive") 
}

record(stringin, "WaveformHeader_CH2") 
{ 
    field(DESC, "Read waveform header CH2") 
    field(DTYP, "stream") 
    field(INP, "@oscilloscope.proto getWaveformHeader() OSCILLO") 
    field(SCAN, "Passive") 
}

record(stringin, "WaveformHeader_CH3") 
{ 
    field(DESC, "Read waveform header CH3") 
    field(DTYP, "stream") 
    field(INP, "@oscilloscope.proto getWaveformHeader() OSCILLO") 
    field(SCAN, "Passive") 
}

record(stringin, "WaveformHeader_CH4") 
{ 
    field(DESC, "Read waveform header CH4") 
    field(DTYP, "stream") 
    field(INP, "@oscilloscope.proto getWaveformHeader() OSCILLO") 
    field(SCAN, "Passive") 
}

#Get waveform data for all channels

record(waveform, "Waveform_CH1") 
{ 
    field(DESC, "Get waveform data from CH1") 
    field(DTYP, "stream") 
    field(INP, "@oscilloscope.proto getWaveformData1 OSCILLO") 
    field(FTVL, "FLOAT") 
    field(NELM, "200000") 
    field(SCAN, "10 second") 
    field(MPST, "Always")
}

 record(waveform, "Waveform_CH2") 
 { 
     field(DESC, "Get waveform data from CH2") 
     field(DTYP, "stream") 
     field(INP, "@oscilloscope.proto getWaveformData2 OSCILLO") 
     field(FTVL, "FLOAT") 
     field(NELM, "200000") 
     field(SCAN, "Passive") 
 }

